# Development Server Configuration
# Copy this file to .env and customize as needed

# Vite dev server host (default: localhost)
VITE_DEV_SERVER_HOST=localhost

# Vite dev server port (default: 3000)
VITE_DEV_SERVER_PORT=3000

# Vite dev server protocol (default: http, use https if needed)
VITE_DEV_SERVER_PROTOCOL=http

# WordPress development URL (for CORS and HMR origin)
VITE_WP_URL=http://localhost

# Theme directory name (used for asset base path)
# Auto-detected from folder name, override if needed
VITE_THEME_NAME=startuptheme
